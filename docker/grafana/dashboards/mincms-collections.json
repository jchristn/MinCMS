{
  "uid": "mincms-collections",
  "title": "MinCMS - Collections",
  "tags": ["mincms", "collections"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operation rate by operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (operation) (rate(mincms_collection_operations_total[5m]))", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outcome (ok vs error)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(mincms_collection_operations_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration p95 by operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(mincms_collection_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate by operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (operation) (rate(mincms_collection_operation_errors_total[5m]))", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Operations in flight",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(mincms_collection_operations_inflight)", "legendFormat": "in flight" }
      ]
    }
  ]
}
